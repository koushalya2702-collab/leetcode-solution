class Solution(object):
    def buildArray(self, target, n):
        """
        :type target: List[int]
        :type n: int
        :rtype: List[str]
        """
        result=[]
        for i in range(1,target[-1]+1):
            if i in target:
                result.append("Push")
            else:
                result.append("Push")
                result.append("Pop")
        return result
